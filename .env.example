# Copy to .env and fill in. Never commit .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Local development
DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production (Passenger / host) — set DEBUG=False and real hosts
# DEBUG=False
# DJANGO_ALLOWED_HOSTS=webjin.ir,www.webjin.ir,dirweb.ir,www.dirweb.ir
# CSRF_TRUSTED_ORIGINS=https://webjin.ir,https://www.webjin.ir,https://dirweb.ir,https://www.dirweb.ir

# MySQL (only used when DEBUG=False)
MYSQL_DATABASE=dirwebir_direct
MYSQL_USER=dirwebir__user
MYSQL_PASSWORD=REPLACE_WITH_ROTATED_PASSWORD
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
